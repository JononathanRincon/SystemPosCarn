datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum PlanNegocio {
  basico
  pro
  enterprise
}

enum TipoVenta {
  peso
  unidad
}

enum UnidadMedida {
  kg
  g
  unidad
}

enum TipoMovimiento {
  venta
  merma
  recepcion
  ajuste_manual
  devolucion
}

enum MotivoMerma {
  corte_proceso
  vencimiento
  dano
  robo
  otro
}

enum EstadoVenta {
  completada
  anulada
}

enum EstadoCorte {
  abierta
  cerrada
}

enum EstadoLote {
  activo
  agotado
  vencido
  retirado
}

// ----------------------------------------------------
// MODELOS DEL SISTEMA POS
// ----------------------------------------------------

model Negocio {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombreComercial  String       @map("nombre_comercial") @db.VarChar(150)
  razonSocial      String       @map("razon_social") @db.VarChar(150)
  nitRut           String       @map("nit_rut") @db.VarChar(50)
  plan             PlanNegocio  @default(basico)
  activo           Boolean      @default(true)
  fechaRegistro    DateTime     @default(now()) @map("fecha_registro") @db.Timestamptz

  sucursales       Sucursal[]
  usuarios         Usuario[]
  categorias       Categoria[]
  productos        Producto[]
  clientes         Cliente[]

  @@map("negocios")
}

model Sucursal {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negocioId        String       @map("negocio_id") @db.Uuid
  nombre           String       @db.VarChar(100)
  direccion        String?      @db.VarChar(200)
  ciudad           String?      @db.VarChar(100)
  zonaHoraria      String       @default("America/Bogota") @map("zona_horaria") @db.VarChar(50)
  activo           Boolean      @default(true)

  negocio          Negocio      @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  usuarios         Usuario[]
  inventarios      Inventario[]
  dispositivos     Dispositivo[]
  ventas           Venta[]
  cortesCaja       CorteDeCaja[]
  mermas           Merma[]
  movimientos      MovimientoInventario[]
  lotes            Lote[]
  recepciones      RecepcionMercancia[]

  @@map("sucursales")
}

model Usuario {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negocioId        String       @map("negocio_id") @db.Uuid
  sucursalId       String?      @map("sucursal_id") @db.Uuid
  nombreCompleto   String       @map("nombre_completo") @db.VarChar(150)
  email            String       @unique @db.VarChar(150)
  passwordHash     String       @map("password_hash") @db.VarChar(255)
  pinPosHash       String       @map("pin_pos_hash") @db.VarChar(255)
  rol              String       @db.VarChar(50)
  activo           Boolean      @default(true)

  negocio          Negocio      @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  sucursal         Sucursal?    @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  ventas           Venta[]
  cortesCaja       CorteDeCaja[]
  mermas           Merma[]
  movimientos      MovimientoInventario[]
  recepciones      RecepcionMercancia[]

  @@map("usuarios")
}

model Categoria {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negocioId        String       @map("negocio_id") @db.Uuid
  nombre           String       @db.VarChar(100)
  ordenVisual      Int          @default(0) @map("orden_visualizacion")

  negocio          Negocio      @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  productos        Producto[]

  @@map("categorias")
}

model Producto {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negocioId        String       @map("negocio_id") @db.Uuid
  categoriaId      String       @map("categoria_id") @db.Uuid
  nombre           String       @db.VarChar(150)
  codigoBarras     String?      @map("codigo_barras") @db.VarChar(100)
  tipoVenta        TipoVenta    @map("tipo_venta")
  unidadMedida     UnidadMedida @map("unidad_medida")
  precio           Decimal      @db.Decimal(12, 2)
  costoPromedio    Decimal      @default(0.00) @map("costo_promedio") @db.Decimal(12, 2)
  fotoUrl          String?      @map("foto_url") @db.Text
  activo           Boolean      @default(true)

  negocio          Negocio      @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  categoria        Categoria    @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  inventarios      Inventario[]
  detallesVenta    DetalleVenta[]
  movimientos      MovimientoInventario[]
  mermas           Merma[]
  lotes            Lote[]

  @@map("productos")
}

model Cliente {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negocioId        String       @map("negocio_id") @db.Uuid
  nombre           String       @db.VarChar(150)
  telefono         String?      @db.VarChar(50)
  saldoFiado       Decimal      @default(0.00) @map("saldo_fiado") @db.Decimal(12, 2)
  limiteCredito    Decimal      @default(0.00) @map("limite_credito") @db.Decimal(12, 2)

  negocio          Negocio      @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  ventas           Venta[]

  @@map("clientes")
}

model Inventario {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productoId          String    @map("producto_id") @db.Uuid
  sucursalId          String    @map("sucursal_id") @db.Uuid
  cantidadActual      Decimal   @default(0.000) @map("cantidad_actual") @db.Decimal(10, 3)
  cantidadMinimaAlerta Decimal  @default(5.000) @map("cantidad_minima_alerta") @db.Decimal(10, 3)
  version             Int       @default(1)
  ultimaActualizacion DateTime  @default(now()) @updatedAt @map("ultima_actualizacion") @db.Timestamptz

  producto            Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  sucursal            Sucursal  @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@unique([productoId, sucursalId])
  @@map("inventarios")
}

model RecepcionMercancia {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sucursalId       String       @map("sucursal_id") @db.Uuid
  usuarioId        String       @map("usuario_id") @db.Uuid
  proveedor        String       @db.VarChar(150)
  fechaRecepcion   DateTime     @default(now()) @map("fecha_recepcion") @db.Timestamptz
  observaciones    String?      @db.Text
  sincronizado     Boolean      @default(true)

  sucursal         Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  usuario          Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  lotes            Lote[]

  @@map("recepciones_mercancia")
}

model Lote {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productoId          String       @map("producto_id") @db.Uuid
  sucursalId          String       @map("sucursal_id") @db.Uuid
  recepcionId         String?      @map("recepcion_id") @db.Uuid
  codigoLote          String       @map("codigo_lote") @db.VarChar(100)
  proveedor           String       @db.VarChar(150)
  cantidadRecibida    Decimal      @map("cantidad_recibida") @db.Decimal(10, 3)
  cantidadDisponible  Decimal      @map("cantidad_disponible") @db.Decimal(10, 3)
  costoUnitario       Decimal      @map("costo_unitario") @db.Decimal(12, 2)
  fechaRecepcion      DateTime     @default(now()) @map("fecha_recepcion") @db.Timestamptz
  fechaVencimiento    DateTime?    @map("fecha_vencimiento") @db.Date
  temperaturaRecepcion Decimal?    @map("temperatura_recepcion") @db.Decimal(4, 1)
  estado              EstadoLote   @default(activo)
  notas               String?      @db.Text
  sincronizado        Boolean      @default(true)

  producto            Producto     @relation(fields: [productoId], references: [id], onDelete: Restrict)
  sucursal            Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  recepcion           RecepcionMercancia? @relation(fields: [recepcionId], references: [id], onDelete: SetNull)
  movimientos         MovimientoInventario[]
  mermas              Merma[]

  @@map("lotes")
}

model MovimientoInventario {
  id                   String         @id @db.Uuid // Generado offline en dispositivo
  productoId           String         @map("producto_id") @db.Uuid
  sucursalId           String         @map("sucursal_id") @db.Uuid
  dispositivoId        String         @map("dispositivo_id") @db.Uuid
  loteId               String?        @map("lote_id") @db.Uuid
  tipo                 TipoMovimiento
  cantidadDelta        Decimal        @map("cantidad_delta") @db.Decimal(10, 3)
  referenciaId         String?        @map("referencia_id") @db.Uuid
  usuarioId            String         @map("usuario_id") @db.Uuid
  fechaHoraDispositivo DateTime       @map("fecha_hora_dispositivo") @db.Timestamptz
  fechaHoraServidor    DateTime       @default(now()) @map("fecha_hora_servidor") @db.Timestamptz
  sincronizado         Boolean        @default(true)

  producto             Producto       @relation(fields: [productoId], references: [id], onDelete: Restrict)
  sucursal             Sucursal       @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  usuario              Usuario        @relation(fields: [usuarioId], references: [id])
  lote                 Lote?          @relation(fields: [loteId], references: [id], onDelete: SetNull)

  @@map("movimientos_inventario")
}

model Merma {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productoId           String       @map("producto_id") @db.Uuid
  sucursalId           String       @map("sucursal_id") @db.Uuid
  loteId               String?      @map("lote_id") @db.Uuid
  dispositivoId        String       @map("dispositivo_id") @db.Uuid
  cantidad             Decimal      @db.Decimal(10, 3)
  motivo               MotivoMerma
  usuarioId            String       @map("usuario_id") @db.Uuid
  fotoEvidenciaUrl     String?      @map("foto_evidencia_url") @db.Text
  fechaHoraDispositivo DateTime     @map("fecha_hora_dispositivo") @db.Timestamptz

  producto             Producto     @relation(fields: [productoId], references: [id], onDelete: Restrict)
  sucursal             Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  usuario              Usuario      @relation(fields: [usuarioId], references: [id])
  lote                 Lote?        @relation(fields: [loteId], references: [id], onDelete: SetNull)

  @@map("mermas")
}

model Venta {
  id                   String       @id @db.Uuid // Generado offline en dispositivo (idempotencia)
  sucursalId           String       @map("sucursal_id") @db.Uuid
  dispositivoId        String       @map("dispositivo_id") @db.Uuid
  cajeroId             String       @map("cajero_id") @db.Uuid
  clienteId            String?      @map("cliente_id") @db.Uuid
  subtotal             Decimal      @db.Decimal(12, 2)
  descuento            Decimal      @default(0.00) @db.Decimal(12, 2)
  total                Decimal      @db.Decimal(12, 2)
  metodoPago           String       @map("metodo_pago") @db.VarChar(30)
  estado               EstadoVenta  @default(completada)
  fechaHoraDispositivo DateTime     @map("fecha_hora_dispositivo") @db.Timestamptz
  fechaHoraServidor    DateTime     @default(now()) @map("fecha_hora_servidor") @db.Timestamptz
  sincronizada         Boolean      @default(true)

  sucursal             Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  cajero               Usuario      @relation(fields: [cajeroId], references: [id])
  cliente              Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  detalles             DetalleVenta[]
  pagos                PagoVenta[]

  @@map("ventas")
}

model DetalleVenta {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ventaId        String       @map("venta_id") @db.Uuid
  productoId     String       @map("producto_id") @db.Uuid
  cantidad       Decimal      @db.Decimal(10, 3)
  precioUnitario Decimal      @map("precio_unitario") @db.Decimal(12, 2)
  subtotalLinea  Decimal      @map("subtotal_linea") @db.Decimal(12, 2)
  pesoBruto      Decimal?     @map("peso_bruto") @db.Decimal(10, 3)
  pesoNeto       Decimal?     @map("peso_neto") @db.Decimal(10, 3)

  venta          Venta        @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto       Producto     @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@map("detalles_venta")
}

model PagoVenta {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ventaId               String   @map("venta_id") @db.Uuid
  metodo                String   @db.VarChar(30)
  monto                 Decimal  @db.Decimal(12, 2)
  referenciaTransaccion String?  @map("referencia_transaccion") @db.VarChar(100)

  venta                 Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@map("pagos_venta")
}

model CorteDeCaja {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sucursalId           String       @map("sucursal_id") @db.Uuid
  dispositivoId        String?      @map("dispositivo_id") @db.Uuid
  usuarioId            String       @map("usuario_id") @db.Uuid
  estado               EstadoCorte  @default(abierta)
  fechaApertura        DateTime     @map("fecha_apertura") @db.Timestamptz
  fechaCierre          DateTime?    @map("fecha_cierre") @db.Timestamptz
  montoApertura        Decimal      @map("monto_apertura") @db.Decimal(12, 2)
  totalEfectivoEsperado Decimal     @default(0.00) @map("total_efectivo_esperado") @db.Decimal(12, 2)
  totalEfectivoContado  Decimal     @default(0.00) @map("total_efectivo_contado") @db.Decimal(12, 2)
  diferencia           Decimal      @default(0.00) @db.Decimal(12, 2)
  totalesPorMetodoPago Json?        @map("totales_por_metodo_pago")
  observaciones        String?      @db.Text

  sucursal             Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  usuario              Usuario      @relation(fields: [usuarioId], references: [id])

  @@map("cortes_caja")
}

model Dispositivo {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sucursalId          String       @map("sucursal_id") @db.Uuid
  nombreAlias         String       @map("nombre_alias") @db.VarChar(100)
  modelo              String?      @db.VarChar(100)
  sistemaOperativo    String?      @map("sistema_operativo") @db.VarChar(100)
  tokenDispositivo    String       @unique @map("token_dispositivo") @db.VarChar(255)
  ultimaSincronizacion DateTime?   @map("ultima_sincronizacion") @db.Timestamptz
  activo              Boolean      @default(true)

  sucursal            Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Restrict)

  @@map("dispositivos")
}
